{
  "name": "oneshot-ship",
  "version": "1.1.0",
  "description": "Ship code in one command. Repo + task in, PR out.",
  "homepage": "https://adwilkinson.github.io/oneshot-cli",
  "type": "module",
  "bin": {
    "oneshot": "src/cli.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "check": "bun run typecheck && bun test && bun run docs:check",
    "docs:check": "node scripts/check-docs.mjs",
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "cli",
    "ai",
    "codex",
    "claude",
    "ssh",
    "bun",
    "code-review",
    "pull-request"
  ],
  "author": "ADWilkinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ADWilkinson/oneshot-cli.git"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "prompts",
    "skills",
    "CHANGELOG.md"
  ]
}
