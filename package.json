{
  "name": "oneshot-ship",
  "version": "0.2.2",
  "description": "Ship code in one command. Repo + task in, PR out.",
  "type": "module",
  "bin": {
    "oneshot": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["cli", "ai", "claude", "codex", "ssh", "bun", "code-review", "pull-request"],
  "author": "ADWilkinson",
  "license": "MIT",
  "repository": "ADWilkinson/oneshot-cli",
  "engines": {
    "bun": ">=1.0.0"
  },
  "os": ["darwin", "linux"],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "prompts",
    "skills"
  ]
}
